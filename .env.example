# RentRoll Environment Configuration Template
# Copy this file to .env and configure your private variables.
# Never commit real secrets to git.

PORT=8000
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-chars
JWT_SECRET=replace-with-a-secure-jwt-signing-key
DJANGO_ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Database Configuration (Neon Serverless PostgreSQL or local SQLite)
# If omitted, Django defaults to local SQLite persistence.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require
