# ============================================================================
# RentRoll — Environment Configuration Reference (Phase 5 Production Release)
# ============================================================================

# Django Core & Security
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate_a_cryptographically_secure_50_char_secret_key_here
JWT_SECRET=generate_a_strong_jwt_signing_secret_here
DJANGO_ALLOWED_HOSTS=rentroll.example.com,localhost,127.0.0.1

# Database Configuration (Leave empty for SQLite, or provide PostgreSQL URI)
# DATABASE_URL=postgres://rentroll_user:secure_password@localhost:5432/rentroll_db

# CORS & CSRF Trusted Origins (Comma-separated URLs)
CORS_ALLOWED_ORIGINS=https://rentroll.example.com,http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=https://rentroll.example.com,https://*.onrender.com

# SSL, HTTPS & Security Headers
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Indian Payment Gateway Integration (Razorpay / Cashfree)
RAZORPAY_KEY_ID=rzp_test_samplekey123456789
RAZORPAY_KEY_SECRET=rzp_test_sampleSecretKey987654321
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret_hmac_2026
PAYMENT_VPA=rentroll@okaxis
PAYMENT_MERCHANT_NAME=RentRoll Property Management

# Email SMTP Notification Configuration
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_sendgrid_api_key
# DEFAULT_FROM_EMAIL=RentRoll Security <security@rentroll.com>
